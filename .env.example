# Local Compose configuration. Java does not automatically load this file.
DB_PASSWORD=local_demo_only
# Set DB_URL / DB_USER / DB_PASSWORD in the Java process environment if overriding defaults.
# Set these in the Java process environment; Java does not load .env automatically.
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3:567m
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional historical provider (not selected by default):
# BIGMODEL_API_KEY=
# BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# Use 8082 for containers if IDEA is running on 8081.
APP_PORT=8081
